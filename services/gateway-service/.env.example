# Server
PORT=5001
NODE_ENV=development

# gRPC service addresses
AUTH_GRPC_ADDR=localhost:50051
USER_GRPC_ADDR=localhost:50052
NOTIFICATION_GRPC_ADDR=localhost:50053
POST_GRPC_ADDR=localhost:50054
COMMUNICATION_GRPC_ADDR=localhost:50056

# JWT verification (must match auth-service ACCESS_SECRET)
JWT_PUBLIC_KEY=dev-access-secret

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Logging level: debug, info, warn, error (defaults to debug in development)
LOG_LEVEL=debug

# Postman sync (scripts/sync-postman.js)
# Generate an API key at https://www.postman.com/settings/me/api-keys
POSTMAN_API_KEY=
POSTMAN_COLLECTION_NAME=COSMIX
SWAGGER_URL=http://localhost:5000/api/docs-json
POSTMAN_BASE_URL=http://localhost:5000
POSTMAN_WORKSPACE_ID=
